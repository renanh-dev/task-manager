<configuration>

    <springProfile name="dev">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>
                    %d{HH:mm:ss}
                    [%thread]
                    %-5level
                    %logger{36}
                    [username:%X{username}]
                    [req:%X{requestId:-}]
                    [trace:%X{traceId:-}]
                    [span:%X{spanId:-}]
                    [%X{method} %X{path}]
                    - %msg%n
                </pattern>
            </encoder>
        </appender>

        <logger name="com.app.taskmanager" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>

        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="prod">
        <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>requestId</includeMdcKeyName>
                <includeMdcKeyName>method</includeMdcKeyName>
                <includeMdcKeyName>path</includeMdcKeyName>
                <includeMdcKeyName>username</includeMdcKeyName>
            </encoder>
        </appender>

        <logger name="com.app.taskmanager" level="INFO" additivity="false">
            <appender-ref ref="JSON_CONSOLE"/>
        </logger>

        <root level="WARN">
            <appender-ref ref="JSON_CONSOLE"/>
        </root>
    </springProfile>

</configuration>